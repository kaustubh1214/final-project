# ==========================================================================
# NaayVadh — environment configuration
# Copy this file to ".env" and fill in real values before deploying.
#   cp .env.example .env
# Docker Compose automatically loads ".env" from this directory.
# ==========================================================================

# --- AI (Google Gemini) ---------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# (App boots fine without it — AI chat replies will return an error until set.)
# NOTE: free-tier keys are capped (~20 requests/day for flash models); a single
# full consultation uses several requests, so enable billing for real users.
GEMINI_API_KEY=
# Model name. "gemini-flash-latest" tracks the newest flash model.
GEMINI_MODEL=gemini-flash-latest

# --- Authentication (JWT) -------------------------------------------------
# REQUIRED. Use a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Database -------------------------------------------------------------
# Default: SQLite stored on the persistent "backend_data" Docker volume.
# (Four slashes = absolute path inside the container.)
DATABASE_URL=sqlite+aiosqlite:////app/data/naayvadh.db

# --- CORS -----------------------------------------------------------------
# Leave blank when the frontend is served by nginx on the same origin (default).
# For a separately hosted frontend, set comma-separated origins, e.g.:
#   CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=

# --- Networking -----------------------------------------------------------
# Host port that serves the web app. Use 80 for HTTP, or e.g. 8080 if 80 is taken.
FRONTEND_PORT=80
